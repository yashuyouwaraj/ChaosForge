FROM node:20

WORKDIR /app

COPY package*.json ./

RUN npm install

COPY . .

ARG API_URL
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SOCKET_URL
ARG NEXT_PUBLIC_GRAFANA_URL
ARG NEXT_PUBLIC_GRAFANA_WAKE_URL
ARG NEXT_PUBLIC_PROMETHEUS_URL

ENV API_URL=$API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_SOCKET_URL=$NEXT_PUBLIC_SOCKET_URL
ENV NEXT_PUBLIC_GRAFANA_URL=$NEXT_PUBLIC_GRAFANA_URL
ENV NEXT_PUBLIC_GRAFANA_WAKE_URL=$NEXT_PUBLIC_GRAFANA_WAKE_URL
ENV NEXT_PUBLIC_PROMETHEUS_URL=$NEXT_PUBLIC_PROMETHEUS_URL

RUN npm run build

EXPOSE 3000

CMD ["npm", "run", "start"]
